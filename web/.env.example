# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string - get a free one at https://neon.tech
# Deployed: use the POOLED host (contains "-pooler"). Migrations use the direct host (see DEPLOYMENT.md).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"   # not needed on Vercel (it is detected)
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ML service (run locally with uvicorn, or the Hugging Face Space URL when deployed)
ML_SERVICE_URL="http://localhost:8000"
# Shared secret the ML service requires on every call except /health. Same value in both places.
# Leave unset locally; REQUIRED when the ML service has a public URL.
# ML_API_KEY=""

# File attachments. "local" stores uploads on disk under UPLOAD_DIR (default: web/.uploads, gitignored).
# Deployed: STORAGE_DRIVER="blob" plus BLOB_READ_WRITE_TOKEN (create a PRIVATE Blob store in the Vercel project).
STORAGE_DRIVER="local"
# UPLOAD_DIR="/absolute/path/to/uploads"
# BLOB_READ_WRITE_TOKEN=""

# Lets admins retrain the classifier from the dashboard. Set the SAME random value in web/.env and ml-service/.env
# (generate with: openssl rand -hex 24). Leave unset to disable retraining.
ML_ADMIN_TOKEN=""

# Realtime. Unset = Socket.io via the local dev server. Set all of these (from a Pusher Channels app) when deployed.
# PUSHER_APP_ID=""
# PUSHER_KEY=""
# PUSHER_SECRET=""
# PUSHER_CLUSTER=""
# NEXT_PUBLIC_PUSHER_KEY=""        # same as PUSHER_KEY
# NEXT_PUBLIC_PUSHER_CLUSTER=""    # same as PUSHER_CLUSTER

# If set, signing up as a support agent requires this invite code. Set it on any public deployment.
# AGENT_SIGNUP_CODE=""
