# Same Postgres connection string used by /web — needed to compare new tickets
# against embeddings of previously resolved tickets for duplicate detection.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Lets admins retrain the classifier from the dashboard. Set the SAME random value in web/.env and ml-service/.env
# (generate with: openssl rand -hex 24). Leave unset to disable retraining.
ML_ADMIN_TOKEN=""
